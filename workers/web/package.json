{
  "name": "blau-shortreel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build && mv .open-next/assets/shotreel/_headers .open-next/assets/_headers",
    "preview": "bun run build:worker && opennextjs-cloudflare preview",
    "deploy": "bun run build:worker && opennextjs-cloudflare deploy",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "typescript": "^5.9.0",
    "wrangler": "4.135.0"
  }
}
